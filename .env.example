# ╔══════════════════════════════════════════════════════════════════════╗
# ║  Forge 环境变量配置                                                   ║
# ║  复制为 .env 后填入实际值。环境变量优先级高于 forge.yaml。               ║
# ╚══════════════════════════════════════════════════════════════════════╝

# ── LLM（必填）────────────────────────────────────────────────────────
LLM_PROVIDER=anthropic
LLM_API_KEY=
LLM_MODEL=claude-sonnet-4-6

# OpenAI 兼容模型示例（DeepSeek / MiniMax / 本地模型等）：
# LLM_PROVIDER=openai
# LLM_API_KEY=sk-xxx
# LLM_MODEL=deepseek-chat
# LLM_BASE_URL=https://api.deepseek.com/v1
#
# 火山方舟 Ark 示例：
# LLM_PROVIDER=openai
# LLM_API_KEY=ark-xxx
# LLM_MODEL=doubao-seed-2-1-pro-260628
# LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# ── Embedding（必填，用于 Schema RAG 召回）─────────────────────────────
# 推荐：硅基流动 bge-m3（免费，中文语义优）
EMBED_API_KEY=
EMBED_BASE_URL=https://api.siliconflow.cn/v1
EMBED_MODEL=BAAI/bge-m3

# ── 数据库（demo-setup.sh 会自动填入 Demo SQLite）─────────────────────
DATABASE_URL=

# ── Pi Orchestrator Integration Spike（默认关闭）──────────────────────
PI_ORCHESTRATOR_ENABLED=false
PI_ORCHESTRATOR_URL=http://127.0.0.1:4310
PI_ORCHESTRATOR_TIMEOUT_SECONDS=300
# Comma-separated org_id:team_id scopes visible in the authenticated Web task monitor.
PI_WEB_ADMIN_TASK_SCOPES=org_default:team_default
# 以下变量注入 Pi Orchestrator 进程；模型凭证存放在专用 agentDir，不继承个人 Pi 配置。
PI_ORCHESTRATOR_AGENT_DIR=services/pi-orchestrator/.runtime
PI_ORCHESTRATOR_STATE_DB=services/pi-orchestrator/.runtime/state/orchestrator.sqlite3
PI_CHANNEL_IDENTITY_MAP=services/pi-orchestrator/.runtime/channel-identities.json
PI_CHANNEL_SERVICE_KEYS=replace-with-a-dedicated-channel-service-key
PI_CHANNEL_AUTO_BIND_FIRST_FEISHU=false
PI_CHANNEL_BOOTSTRAP_ORG_ID=org_default
PI_CHANNEL_BOOTSTRAP_TEAM_ID=team_default
PI_CHANNEL_BOOTSTRAP_USER_ID=feishu_owner
PI_ADMIN_SERVICE_KEYS=replace-with-a-dedicated-admin-service-key
PI_CHANNEL_SERVICE_KEY=replace-with-the-same-dedicated-channel-service-key
FEISHU_PI_ENABLED=false
# Deadline hierarchy: query prepare 210s < Forge HTTP 220s < Pi Stage 240s < lease 300s.
QUERY_PREPARE_TIMEOUT_SECONDS=210
FORGE_REQUEST_TIMEOUT_MS=220000
PI_STAGE_TIMEOUT_MS=240000
PI_STAGE_LEASE_MS=300000
PI_RECONCILIATION_INTERVAL_MS=30000
PI_MODEL_PROVIDER=volcengine-coding-plan
PI_MODEL_ID=ark-code-latest
PI_MODEL_SECRET_REF=
# Coding Plan 专属 Key；Pi models.json 仅通过环境变量引用，不写入配置文件。
ARK_API_KEY=
FORGE_PI_SERVICE_KEY=
# Forge 用于验证 Pi 内部 QueryRun API；为空时内部 API 全部拒绝。
PI_SERVICE_API_KEYS=
QUERY_RUN_DB_PATH=.forge/query_runs.db
REPORT_DB_PATH=.forge/reports.db
REPORT_ARTIFACT_DIR=.forge/report-artifacts
REPORT_PUBLIC_BASE_URL=http://localhost:8000
PI_MODEL_CATALOG_PATH=services/pi-orchestrator/.runtime/models.json
MODEL_CONTROL_DB_PATH=.forge/model_control.db
MODEL_VALIDATION_CASES_PATH=
MODEL_VALIDATION_DATABASE_URL=
MODEL_VALIDATION_DATABASE_READONLY_CONFIRMED=false
QUERY_RUN_REVIEW_TTL_SECONDS=900
DATASOURCE_ID=default

# ── 飞书 Bot（可选，不用飞书可留空）───────────────────────────────────
FEISHU_APP_ID=
FEISHU_APP_SECRET=
