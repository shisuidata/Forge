# Forge production environment template
#
# 复制为 .env.production 或由部署平台注入同名环境变量。
# 不要把真实密钥提交到 Git。

# ── Runtime ────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
LOG_FILE=/app/.forge/logs/forge.log

# ── Auth ───────────────────────────────────────────────────────────────────
AUTH_ENABLED=true
AUTH_PASSWORD=change-this-long-random-password
AUTH_API_KEYS=change-this-api-key
AUTH_COOKIE_SECURE=true

# ── LLM ────────────────────────────────────────────────────────────────────
LLM_PROVIDER=openai
LLM_MODEL=deepseek-v4-pro
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=replace-with-your-key
LLM_TOOL_CHOICE=auto
LLM_TIMEOUT_SECONDS=120
# 火山方舟 Ark 可改为：
# LLM_MODEL=doubao-seed-2-1-pro-260628
# LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# 方舟 Coding Plan 使用专属网关，不能和普通 Ark API 混用：
# LLM_MODEL=ark-code-latest
# LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/coding/v3

# ── Database ───────────────────────────────────────────────────────────────
# 必须使用客户数据库的只读账号或只读副本。
DATABASE_URL=postgresql://forge_readonly:replace-password@db.example.internal:5432/warehouse
SQL_DIALECT=postgresql
DATABASE_READONLY_CONFIRMED=false

# ── SQL execution guardrails ───────────────────────────────────────────────
EXECUTION_ENABLED=true
RAW_SQL_ENABLED=false
EXECUTION_MAX_ROWS=200
EXECUTION_DISPLAY_ROWS=50
EXECUTION_TIMEOUT_SECONDS=30

# ── Registry ───────────────────────────────────────────────────────────────
REGISTRY_PATH=/app/registry/data/schema.registry.json
METRICS_PATH=/app/registry/data/metrics.registry.yaml
DISAMBIGUATIONS_PATH=/app/registry/data/disambiguations.registry.yaml
CONVENTIONS_PATH=/app/registry/data/field_conventions.registry.yaml
STAGING_DIR=/app/.forge/staging

# ── Audit / memory ─────────────────────────────────────────────────────────
AUDIT_DB_PATH=/app/.forge/audit/forge_audit.db
MEMORY_DB_PATH=/app/.forge/memory.db
