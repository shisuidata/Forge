# Forge production environment template
#
# 复制为 .env.production 或由部署平台注入同名环境变量。
# 不要把真实密钥提交到 Git。

# ── Runtime ────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
LOG_FILE=/app/.forge/logs/forge.log

# ── Auth ───────────────────────────────────────────────────────────────────
AUTH_ENABLED=true
AUTH_PASSWORD=change-this-long-random-password
AUTH_API_KEYS=change-this-api-key
AUTH_COOKIE_SECURE=true

# ── Pi Orchestrator ─────────────────────────────────────────────────────────
# Integration Spike 默认关闭；部署独立 Pi 服务并完成内网隔离后再开启。
PI_ORCHESTRATOR_ENABLED=false
PI_ORCHESTRATOR_URL=http://pi-orchestrator:4310
PI_ORCHESTRATOR_TIMEOUT_SECONDS=300
PI_SERVICE_API_KEYS=replace-with-dedicated-pi-service-key
QUERY_RUN_DB_PATH=/app/.forge/query_runs.db
REPORT_DB_PATH=/app/.forge/reports.db
REPORT_ARTIFACT_DIR=/app/.forge/report-artifacts
REPORT_PUBLIC_BASE_URL=https://forge.example.com
PI_MODEL_CATALOG_PATH=/app/.forge/pi-agent/models.json
MODEL_CONTROL_DB_PATH=/app/.forge/model_control.db
MODEL_VALIDATION_CASES_PATH=/app/tests/datasets/large/cases.json
MODEL_VALIDATION_DATABASE_URL=
MODEL_VALIDATION_DATABASE_READONLY_CONFIRMED=false
QUERY_RUN_REVIEW_TTL_SECONDS=900
DATASOURCE_ID=warehouse-primary

# Pi 服务应单独注入以下变量。模型凭证和 models.json 挂载到专用 agentDir。
FORGE_PI_SERVICE_KEY=replace-with-dedicated-pi-service-key
PI_ORCHESTRATOR_AGENT_DIR=/app/pi-runtime
PI_ORCHESTRATOR_STATE_DB=/app/pi-state/orchestrator.sqlite3
PI_CHANNEL_IDENTITY_MAP=/app/pi-runtime/channel-identities.json
PI_CHANNEL_SERVICE_KEYS=replace-with-a-dedicated-channel-service-key
# Personal deployment only: atomically bind the first authenticated Feishu sender.
PI_CHANNEL_AUTO_BIND_FIRST_FEISHU=false
PI_CHANNEL_BOOTSTRAP_ORG_ID=org_default
PI_CHANNEL_BOOTSTRAP_TEAM_ID=team_default
PI_CHANNEL_BOOTSTRAP_USER_ID=feishu_owner
PI_ADMIN_SERVICE_KEYS=replace-with-a-dedicated-admin-service-key
PI_CHANNEL_SERVICE_KEY=replace-with-the-same-dedicated-channel-service-key
FEISHU_PI_ENABLED=false
PI_STAGE_TIMEOUT_MS=240000
PI_STAGE_LEASE_MS=300000
PI_RECONCILIATION_INTERVAL_MS=30000
PI_MODEL_PROVIDER=volcengine-coding-plan
PI_MODEL_ID=ark-code-latest
# Optional: read exactly one key from an existing mode-600 secret file.
PI_MODEL_SECRET_REF=
ARK_API_KEY=replace-with-coding-plan-key
# FORGE_PI_SERVICE_KEY 必须属于 Forge 的 PI_SERVICE_API_KEYS。
# 仅调用旧 /api/prepare-query 时才使用属于 AUTH_API_KEYS 的 FORGE_API_KEY。

# ── LLM ────────────────────────────────────────────────────────────────────
LLM_PROVIDER=openai
LLM_MODEL=deepseek-v4-pro
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=replace-with-your-key
LLM_TOOL_CHOICE=auto
LLM_TIMEOUT_SECONDS=120
# 整个查询准备（含模型自修正）必须小于 Pi 的 Forge HTTP/Stage timeout。
QUERY_PREPARE_TIMEOUT_SECONDS=210
# 火山方舟 Ark 可改为：
# LLM_MODEL=doubao-seed-2-1-pro-260628
# LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# 方舟 Coding Plan 使用专属网关，不能和普通 Ark API 混用：
# LLM_MODEL=ark-code-latest
# LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/coding/v3

# ── Database ───────────────────────────────────────────────────────────────
# 必须使用客户数据库的只读账号或只读副本。
DATABASE_URL=postgresql://forge_readonly:replace-password@db.example.internal:5432/warehouse
SQL_DIALECT=postgresql
DATABASE_READONLY_CONFIRMED=false

# ── SQL execution guardrails ───────────────────────────────────────────────
EXECUTION_ENABLED=true
RAW_SQL_ENABLED=false
EXECUTION_MAX_ROWS=200
EXECUTION_DISPLAY_ROWS=50
EXECUTION_TIMEOUT_SECONDS=30

# ── Registry ───────────────────────────────────────────────────────────────
REGISTRY_PATH=/app/registry/data/schema.registry.json
METRICS_PATH=/app/registry/data/metrics.registry.yaml
DISAMBIGUATIONS_PATH=/app/registry/data/disambiguations.registry.yaml
CONVENTIONS_PATH=/app/registry/data/field_conventions.registry.yaml
STAGING_DIR=/app/.forge/staging

# ── Audit / memory ─────────────────────────────────────────────────────────
AUDIT_DB_PATH=/app/.forge/audit/forge_audit.db
MEMORY_DB_PATH=/app/.forge/memory.db
