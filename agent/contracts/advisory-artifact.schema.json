{
  "type": "object",
  "required": [
    "artifact_id",
    "artifact_type",
    "schema_version",
    "task_run_id",
    "producer",
    "created_at",
    "payload"
  ],
  "properties": {
    "artifact_id": {
      "type": "string",
      "pattern": "^ar_[A-Za-z0-9_-]+$"
    },
    "artifact_type": {
      "type": "string",
      "const": "advisory"
    },
    "schema_version": {
      "type": "number",
      "const": 1
    },
    "task_run_id": {
      "type": "string",
      "pattern": "^tr_[A-Za-z0-9_-]+$"
    },
    "producer": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "payload": {
      "type": "object",
      "required": [
        "status",
        "skill_name",
        "title",
        "summary",
        "findings",
        "recommendations",
        "assumptions",
        "limitations",
        "open_questions",
        "deliverables"
      ],
      "properties": {
        "status": {
          "anyOf": [
            {
              "type": "string",
              "const": "complete"
            },
            {
              "type": "string",
              "const": "incomplete"
            }
          ]
        },
        "skill_name": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "findings": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "statement",
              "evidence_refs",
              "confidence"
            ],
            "properties": {
              "statement": {
                "type": "string",
                "minLength": 1
              },
              "evidence_refs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^(?:qr_[A-Za-z0-9_-]+#.+|ctx_[a-f0-9]{24})$"
                },
                "uniqueItems": true
              },
              "confidence": {
                "anyOf": [
                  {
                    "type": "string",
                    "const": "high"
                  },
                  {
                    "type": "string",
                    "const": "medium"
                  },
                  {
                    "type": "string",
                    "const": "low"
                  }
                ]
              }
            },
            "additionalProperties": false
          }
        },
        "recommendations": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "action",
              "rationale",
              "priority"
            ],
            "properties": {
              "action": {
                "type": "string",
                "minLength": 1
              },
              "rationale": {
                "type": "string",
                "minLength": 1
              },
              "priority": {
                "anyOf": [
                  {
                    "type": "string",
                    "const": "immediate"
                  },
                  {
                    "type": "string",
                    "const": "high"
                  },
                  {
                    "type": "string",
                    "const": "medium"
                  },
                  {
                    "type": "string",
                    "const": "low"
                  }
                ]
              }
            },
            "additionalProperties": false
          }
        },
        "assumptions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "open_questions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "deliverables": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "content"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "content": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forge.local/contracts/advisory-artifact.schema.json",
  "additionalProperties": false
}
