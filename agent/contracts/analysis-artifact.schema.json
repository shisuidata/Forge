{
  "type": "object",
  "required": [
    "artifact_id",
    "artifact_type",
    "schema_version",
    "task_run_id",
    "producer",
    "created_at",
    "payload"
  ],
  "properties": {
    "artifact_id": {
      "type": "string",
      "pattern": "^ar_[A-Za-z0-9_-]+$"
    },
    "artifact_type": {
      "type": "string",
      "const": "analysis"
    },
    "schema_version": {
      "type": "number",
      "const": 1
    },
    "task_run_id": {
      "type": "string",
      "pattern": "^tr_[A-Za-z0-9_-]+$"
    },
    "producer": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "payload": {
      "type": "object",
      "required": [
        "status",
        "method_summary",
        "summary",
        "findings",
        "hypotheses",
        "recommendations",
        "limitations",
        "suggested_queries"
      ],
      "properties": {
        "status": {
          "anyOf": [
            {
              "type": "string",
              "const": "complete"
            },
            {
              "type": "string",
              "const": "incomplete"
            }
          ]
        },
        "method_summary": {
          "type": "object",
          "required": [
            "objective",
            "dimensions",
            "comparison_baseline",
            "approach_steps"
          ],
          "properties": {
            "objective": {
              "type": "string",
              "minLength": 1
            },
            "dimensions": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            },
            "comparison_baseline": {
              "type": "string",
              "minLength": 1
            },
            "approach_steps": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1,
              "maxItems": 6
            }
          },
          "additionalProperties": false
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "findings": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "statement",
              "evidence_refs",
              "confidence"
            ],
            "properties": {
              "statement": {
                "type": "string",
                "minLength": 1
              },
              "evidence_refs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^qr_[A-Za-z0-9_-]+#.+$"
                },
                "minItems": 1,
                "uniqueItems": true
              },
              "confidence": {
                "anyOf": [
                  {
                    "type": "string",
                    "const": "high"
                  },
                  {
                    "type": "string",
                    "const": "medium"
                  },
                  {
                    "type": "string",
                    "const": "low"
                  }
                ]
              }
            },
            "additionalProperties": false
          }
        },
        "hypotheses": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "statement",
              "evidence_refs",
              "status"
            ],
            "properties": {
              "statement": {
                "type": "string",
                "minLength": 1
              },
              "evidence_refs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^qr_[A-Za-z0-9_-]+#.+$"
                },
                "uniqueItems": true
              },
              "status": {
                "anyOf": [
                  {
                    "type": "string",
                    "const": "supported"
                  },
                  {
                    "type": "string",
                    "const": "plausible"
                  },
                  {
                    "type": "string",
                    "const": "unverified"
                  },
                  {
                    "type": "string",
                    "const": "rejected"
                  }
                ]
              }
            },
            "additionalProperties": false
          }
        },
        "recommendations": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "action",
              "rationale",
              "priority"
            ],
            "properties": {
              "action": {
                "type": "string",
                "minLength": 1
              },
              "rationale": {
                "type": "string",
                "minLength": 1
              },
              "priority": {
                "anyOf": [
                  {
                    "type": "string",
                    "const": "immediate"
                  },
                  {
                    "type": "string",
                    "const": "high"
                  },
                  {
                    "type": "string",
                    "const": "medium"
                  },
                  {
                    "type": "string",
                    "const": "low"
                  }
                ]
              }
            },
            "additionalProperties": false
          }
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "suggested_queries": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "question",
              "reason",
              "priority"
            ],
            "properties": {
              "question": {
                "type": "string",
                "minLength": 1
              },
              "reason": {
                "type": "string",
                "minLength": 1
              },
              "priority": {
                "anyOf": [
                  {
                    "type": "string",
                    "const": "high"
                  },
                  {
                    "type": "string",
                    "const": "medium"
                  },
                  {
                    "type": "string",
                    "const": "low"
                  }
                ]
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forge.local/contracts/analysis-artifact.schema.json",
  "additionalProperties": false
}
