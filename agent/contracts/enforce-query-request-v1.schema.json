{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forge.shisuidata.com/contracts/enforce-query-request-v1.schema.json",
  "title": "EnforceQueryRequestV1",
  "description": "A public request to prepare one governed query candidate for explicit human review and read-only execution.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_run_id",
    "purpose",
    "question",
    "principal_context",
    "delegated_mandate",
    "resource_scope",
    "candidate",
    "dialect"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "task_run_id": {"type": "string", "pattern": "^tr_[A-Za-z0-9_-]+$", "maxLength": 128},
    "purpose": {"type": "string", "minLength": 1, "maxLength": 1000},
    "question": {"type": "string", "minLength": 1, "maxLength": 10000},
    "principal_context": {"type": "object"},
    "delegated_mandate": {"type": ["object", "null"]},
    "resource_scope": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {"type": "object"}
    },
    "candidate": {"type": "object"},
    "dialect": {
      "enum": ["auto", "sqlite", "postgresql", "mysql", "bigquery", "snowflake"]
    }
  }
}
