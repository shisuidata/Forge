{
  "type": "object",
  "required": [
    "artifact_id",
    "artifact_type",
    "schema_version",
    "task_run_id",
    "producer",
    "created_at",
    "payload"
  ],
  "properties": {
    "artifact_id": {
      "type": "string",
      "pattern": "^ar_[A-Za-z0-9_-]+$"
    },
    "artifact_type": {
      "type": "string",
      "const": "rendered_output"
    },
    "schema_version": {
      "type": "number",
      "const": 1
    },
    "task_run_id": {
      "type": "string",
      "pattern": "^tr_[A-Za-z0-9_-]+$"
    },
    "producer": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "payload": {
      "type": "object",
      "required": [
        "status",
        "title",
        "audience",
        "executive_summary",
        "key_findings",
        "recommendations",
        "limitations",
        "next_steps",
        "source_artifact_ids",
        "markdown"
      ],
      "properties": {
        "status": {
          "anyOf": [
            {
              "type": "string",
              "const": "complete"
            },
            {
              "type": "string",
              "const": "incomplete"
            }
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "audience": {
          "type": "string",
          "minLength": 1
        },
        "executive_summary": {
          "type": "string",
          "minLength": 1
        },
        "key_findings": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "statement",
              "interpretation",
              "evidence_refs",
              "confidence"
            ],
            "properties": {
              "statement": {
                "type": "string",
                "minLength": 1
              },
              "interpretation": {
                "type": "string",
                "minLength": 1
              },
              "evidence_refs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^qr_[A-Za-z0-9_-]+#.+$"
                },
                "minItems": 1,
                "uniqueItems": true
              },
              "confidence": {
                "anyOf": [
                  {
                    "type": "string",
                    "const": "high"
                  },
                  {
                    "type": "string",
                    "const": "medium"
                  },
                  {
                    "type": "string",
                    "const": "low"
                  }
                ]
              }
            },
            "additionalProperties": false
          }
        },
        "recommendations": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "action",
              "rationale",
              "priority"
            ],
            "properties": {
              "action": {
                "type": "string",
                "minLength": 1
              },
              "rationale": {
                "type": "string",
                "minLength": 1
              },
              "priority": {
                "anyOf": [
                  {
                    "type": "string",
                    "const": "immediate"
                  },
                  {
                    "type": "string",
                    "const": "high"
                  },
                  {
                    "type": "string",
                    "const": "medium"
                  },
                  {
                    "type": "string",
                    "const": "low"
                  }
                ]
              }
            },
            "additionalProperties": false
          }
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "next_steps": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "source_artifact_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^ar_[A-Za-z0-9_-]+$"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "markdown": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forge.local/contracts/rendered-output-artifact.schema.json",
  "additionalProperties": false
}
