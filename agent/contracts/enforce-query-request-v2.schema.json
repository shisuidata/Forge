{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forge.shisuidata.com/contracts/enforce-query-request-v2.schema.json",
  "title": "EnforceQueryRequestV2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "mandate_id",
    "task_run_id",
    "purpose",
    "question",
    "candidate",
    "dialect"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "mandate_id": {
      "type": "string",
      "pattern": "^md_[A-Za-z0-9_-]+$"
    },
    "task_run_id": {
      "type": "string",
      "pattern": "^tr_[A-Za-z0-9_-]+$",
      "maxLength": 128
    },
    "purpose": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "question": {
      "type": "string",
      "minLength": 1,
      "maxLength": 10000
    },
    "candidate": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "https://forge.shisuidata.com/contracts/query-candidate-v1.schema.json",
      "title": "QueryCandidateV1",
      "description": "A query candidate submitted to Forge assurance before QueryRun review and execution.",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "sql"
          ],
          "properties": {
            "kind": {
              "const": "direct_sql"
            },
            "sql": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100000
            },
            "producer_revision": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "forge_json"
          ],
          "properties": {
            "kind": {
              "const": "forge_json"
            },
            "forge_json": {
              "type": "object"
            },
            "producer_revision": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          }
        }
      ]
    },
    "dialect": {
      "enum": [
        "auto",
        "sqlite",
        "postgresql",
        "mysql",
        "bigquery",
        "snowflake"
      ]
    }
  }
}
