{
  "type": "object",
  "required": [
    "artifact_id",
    "artifact_type",
    "schema_version",
    "task_run_id",
    "producer",
    "created_at",
    "payload"
  ],
  "properties": {
    "artifact_id": {
      "type": "string",
      "pattern": "^ar_[A-Za-z0-9_-]+$"
    },
    "artifact_type": {
      "type": "string",
      "const": "query_result"
    },
    "schema_version": {
      "type": "number",
      "const": 1
    },
    "task_run_id": {
      "type": "string",
      "pattern": "^tr_[A-Za-z0-9_-]+$"
    },
    "producer": {
      "type": "string",
      "const": "forge"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "payload": {
      "type": "object",
      "required": [
        "query_run_id",
        "sql_hash",
        "columns",
        "rows",
        "row_count",
        "truncated",
        "dialect",
        "registry_version",
        "execution_ms",
        "executed_at"
      ],
      "properties": {
        "query_run_id": {
          "type": "string",
          "pattern": "^qr_[A-Za-z0-9_-]+$"
        },
        "sql_hash": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "columns": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "rows": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {}
          }
        },
        "row_count": {
          "type": "integer",
          "minimum": 0
        },
        "truncated": {
          "type": "boolean"
        },
        "dialect": {
          "anyOf": [
            {
              "type": "string",
              "const": "sqlite"
            },
            {
              "type": "string",
              "const": "postgresql"
            },
            {
              "type": "string",
              "const": "mysql"
            },
            {
              "type": "string",
              "const": "bigquery"
            },
            {
              "type": "string",
              "const": "snowflake"
            }
          ]
        },
        "registry_version": {
          "type": "string",
          "minLength": 1
        },
        "assurance_report_hash": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "assurance_revision": {
          "type": "string",
          "minLength": 1
        },
        "policy_revision": {
          "type": "string",
          "minLength": 1
        },
        "model_revision": {
          "type": "string",
          "minLength": 1
        },
        "assurance_registry_revision": {
          "type": "string",
          "minLength": 1
        },
        "execution_ms": {
          "type": "integer",
          "minimum": 0
        },
        "executed_at": {
          "type": "string",
          "minLength": 1,
          "format": "date-time"
        },
        "result_contract": {
          "anyOf": [
            {
              "type": "object",
              "patternProperties": {
                "^.*$": {}
              }
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forge.local/contracts/query-result-artifact.schema.json",
  "additionalProperties": false
}
