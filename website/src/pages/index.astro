---
import Mark from '../components/Mark.astro';
import '../styles/landing.css';

const github = 'https://github.com/shisuidata/Forge';
const report = `${github}/blob/main/docs/archive/engineering/latest-test-report-2026-10-22.md`;
const install = 'git clone https://github.com/shisuidata/Forge\ncd Forge\nbash scripts/bootstrap-dev.sh\nsource .venv/bin/activate\nforge quickstart --agent';

// Synthetic walkthrough of the same scenario `forge quickstart --agent` runs. Not live data.
type Cell = { state: 'pass' | 'deny' | 'wait' | 'skip'; text: string };
const gates = ['只读', '解析', '表权限', '授权范围'];
const lanes: { sql: string; note: string; cells: Cell[]; outcome: Cell }[] = [
	{
		sql: 'SELECT n FROM numbers', note: '自主子集内的表',
		cells: [{ state: 'pass', text: '通过' }, { state: 'pass', text: '通过' }, { state: 'pass', text: '通过' }, { state: 'pass', text: '自主子集' }],
		outcome: { state: 'pass', text: 'Agent 直接执行' },
	},
	{
		sql: 'SELECT value FROM secrets', note: '范围内，但不在自主子集',
		cells: [{ state: 'pass', text: '通过' }, { state: 'pass', text: '通过' }, { state: 'pass', text: '通过' }, { state: 'wait', text: '需审核' }],
		outcome: { state: 'wait', text: '指定审核人批准后执行' },
	},
	{
		sql: 'DELETE FROM numbers', note: '写入请求',
		cells: [{ state: 'deny', text: 'readonly_violation' }, { state: 'skip', text: '—' }, { state: 'skip', text: '—' }, { state: 'skip', text: '—' }],
		outcome: { state: 'deny', text: '拒绝，不执行' },
	},
	{
		sql: 'SELECT n FROM numbers', note: '管理员撤销授权之后',
		cells: [{ state: 'skip', text: '—' }, { state: 'skip', text: '—' }, { state: 'skip', text: '—' }, { state: 'deny', text: '已撤销' }],
		outcome: { state: 'deny', text: '409 mandate_inactive' },
	},
];

const stages = [
	{
		n: '01', name: 'Evaluate', title: '先检查候选，不执行',
		does: ['只读、语法、Registry 与表权限检查', '失败按阶段分类，可回放、可做回归门禁', 'Direct SQL 与 Forge JSON 走同一条检查链'],
		not: '评估通过不授予执行权。', href: '/reference/benchmarks/',
	},
	{
		n: '02', name: 'Enforce', title: '按授权放行、等待或拒绝',
		does: ['主体、任务、授权范围与 SQL 绑定到同一个 QueryRun', '检查与执行使用同一份解析结果', '越界、漂移、撤销一律失败关闭'],
		not: '获得授权不等于查询表达了正确的业务意图。', href: '/concepts/how-it-works/',
	},
	{
		n: '03', name: 'Explain', title: '交付结果，也交付依据',
		does: ['回读实际 SQL、结果、语义来源与审批链', '证据在写入时绑定 hash，篡改即失败', '把没有证明的部分写进限制'],
		not: '证据完整不等于语义正确。', href: '/guides/introduction/',
	},
];

const permit = [
	['委托主体', 'agent · worker'],
	['签发人', 'human · admin'],
	['任务', 'tr_quickstart'],
	['数据源', 'demo'],
	['允许的表', 'numbers, secrets'],
	['自主子集', 'numbers'],
	['指定审核人', 'human · reviewer'],
	['有效期', '≤ 24 小时'],
];

const record = [
	{ figure: '1049', unit: 'passed', label: 'Python 全套测试', note: '26 skipped · 仓库检出' },
	{ figure: '226', unit: 'passed', label: 'Pi Orchestrator', note: 'Node 22 与 24 · typecheck 通过' },
	{ figure: '5/5', unit: 'CI', label: '远端 CI 任务', note: 'test · wheel · sdist · 兼容 · Pi' },
	{ figure: '2/2', unit: '安装方式', label: 'wheel 与 sdist 全新安装', note: '安装后 package smoke 与 Quickstart 通过' },
];
const limitations = ['semantic_correctness_unproven', 'live_data_no_snapshot', 'authorization_is_not_semantic_correctness', 'result_truncated'];
const unverified = ['真实 PostgreSQL / MySQL 只读角色', '真实身份与客户数据', '独立安全审核与渗透测试', '非维护者的外部采用'];

const faqs = [
	['Forge 是另一个问数聊天机器人吗？', '不是。Forge 位于你已有的 Agent 与数据库之间，负责生成之后的检查、受控执行与证据。外部 Agent 可以直接调用 Forge 的 HTTP API，不需要使用我们的工作台或编排器。'],
	['必须让模型生成 Forge JSON 吗？', '不必。Direct SQL 与 Forge JSON 都是候选格式，进入同一条 QueryRun 治理链路。Forge JSON 能提供更强的结构约束，但它不是接入的前提。'],
	['Quickstart 会连接我的数据库或调用模型吗？', '不会。它在本地创建隔离的合成 SQLite 数据与合成身份，启动真实的本地服务，不需要模型、API Key 或你的数据库。'],
	['现在可以接入生产吗？', '不建议。2026-10-04 评估列出的发布阻断已经修复并有回归测试，但真实数据库只读角色、真实身份与独立安全审核都还没有验证；数据库只读角色始终是最后一道边界。请先在隔离环境评估。'],
];
---
<!doctype html>
<html lang="zh-CN">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#0f1114" />
		<title>Forge — Agent 写的每条 SQL，先过关，再执行</title>
		<meta name="description" content="Forge 是开源的 Data Agent 可信数据运行时：评估候选 SQL，按授权放行、等待审核或拒绝，并为每次执行留下可校验的证据。" />
		<meta property="og:title" content="Forge — Agent 写的每条 SQL，先过关，再执行" />
		<meta property="og:description" content="开源 Trust Runtime：Evaluate → Enforce → Explain。有界授权、指定审核人、可撤销，执行后交付证据与限制。" />
		<meta property="og:type" content="website" />
		<meta property="og:url" content="https://forge.ss-data.cc/" />
		<link rel="canonical" href="https://forge.ss-data.cc/" />
		<link rel="icon" href="/favicon.ico" sizes="any" />
		<link rel="icon" type="image/svg+xml" href="/brand/forge-mark.svg" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
	</head>
	<body>
		<a class="skip-link" href="#main">跳至内容</a>
		<header class="bar">
			<div class="bar-inner wrap">
				<a class="brand" href="/" aria-label="Forge 首页"><Mark size={30} /><span>FORGE</span></a>
				<button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-nav">
					<span class="menu-toggle-label">菜单</span><span class="menu-toggle-icon" aria-hidden="true"></span>
				</button>
				<nav id="site-nav" class="nav" aria-label="主导航">
					<a href="#gates">三道关口</a>
					<a href="#mandate">有界授权</a>
					<a href="#evidence">证据</a>
					<a href="#record">验证记录</a>
					<a href="/guides/introduction/">文档</a>
					<a href={github} rel="noopener">GitHub</a>
					<a class="nav-cta" href="/guides/quickstart/">五分钟上手</a>
				</nav>
			</div>
		</header>

		<main id="main">
			<section class="hero wrap" aria-labelledby="hero-title">
				<div class="hero-copy">
					<p class="kicker"><span class="kicker-dot" aria-hidden="true"></span>开源 · Apache-2.0 · Trust Runtime for Data Agents</p>
					<h1 id="hero-title">Agent 写的每条 SQL，<br /><em>先过关，</em>再执行。</h1>
					<p class="lede">Forge 是位于 Agent 与数据库之间的开源可信数据运行时。它检查候选 SQL，按授权决定放行、等待审核或拒绝，并为每次执行留下可校验的证据。</p>
					<div class="hero-actions">
						<a class="button button-signal" href="/guides/quickstart/">五分钟上手<span aria-hidden="true">→</span></a>
						<div class="command-chip">
							<code>forge quickstart --agent</code>
							<button class="copy" type="button" data-copy="forge quickstart --agent" aria-label="复制命令">复制</button>
						</div>
					</div>
					<p class="hero-meta">本地合成数据运行 · 不需要模型、API Key 或你的数据库</p>
				</div>
			</section>

			<section class="board-wrap wrap" aria-labelledby="board-title">
				<div class="board" data-board>
					<div class="board-head">
						<p id="board-title" class="board-title"><span class="mono">CHECKPOINT</span> 同一项授权下的四次请求</p>
						<p class="board-note">合成示意 · 与 <code>forge quickstart --agent</code> 同一场景 · 非实时</p>
						<button class="replay" type="button" data-replay>重放</button>
					</div>
					<table class="lanes">
						<thead>
							<tr>
								<th scope="col">候选 SQL</th>
								{gates.map((gate) => <th scope="col">{gate}</th>)}
								<th scope="col">结果</th>
							</tr>
						</thead>
						<tbody>
							{lanes.map((lane, row) => (
								<tr>
									<th scope="row"><code>{lane.sql}</code><span>{lane.note}</span></th>
									{lane.cells.map((cell, column) => (
										<td data-label={gates[column]}><span class:list={['stamp', cell.state]} style={`--d:${row * 0.55 + column * 0.12 + 0.2}s`}>{cell.text}</span></td>
									))}
									<td class="outcome" data-label="结果"><span class:list={['stamp', 'stamp-outcome', lane.outcome.state]} style={`--d:${row * 0.55 + 0.75}s`}>{lane.outcome.text}</span></td>
								</tr>
							))}
						</tbody>
					</table>
				</div>
			</section>

			<div class="hazard" aria-hidden="true"></div>

			<section id="gates" class="section wrap" aria-labelledby="gates-title">
				<header class="section-head">
					<p class="eyebrow">Evaluate → Enforce → Explain</p>
					<h2 id="gates-title">三道关口，<br />每道都说清自己证明不了什么。</h2>
				</header>
				<ol class="stages">
					{stages.map((stage) => (
						<li class="stage">
							<p class="stage-n mono">{stage.n}</p>
							<h3><span class="stage-name">{stage.name}</span>{stage.title}</h3>
							<ul>{stage.does.map((item) => <li>{item}</li>)}</ul>
							<p class="stage-not"><span class="mono">不证明</span>{stage.not}</p>
							<a class="stage-link" href={stage.href}>了解 {stage.name}<span aria-hidden="true">→</span></a>
						</li>
					))}
				</ol>
			</section>

			<section id="mandate" class="section split wrap" aria-labelledby="mandate-title">
				<div class="split-copy">
					<p class="eyebrow">有界授权</p>
					<h2 id="mandate-title">给 Agent 一张有边界的通行证，<br />不是一把万能钥匙。</h2>
					<p>Agent 是独立的凭证主体。管理员为单个任务签发有期限、有范围的授权：允许哪些表、其中哪些可以自主执行、范围外由哪位真人审核。</p>
					<p>授权的撤销与执行的领取在同一个数据库事务里按先后生效；撤销之后，新的请求一律拒绝。</p>
					<dl class="rules">
						<div><dt class="pass">自主子集内</dt><dd>Agent 直接执行</dd></div>
						<div><dt class="wait">范围内、非自主</dt><dd>指定审核人批准后执行</dd></div>
						<div><dt class="deny">范围外或写入</dt><dd>拒绝</dd></div>
						<div><dt class="deny">撤销之后</dt><dd>新请求返回 409</dd></div>
					</dl>
				</div>
				<figure class="permit" aria-labelledby="permit-caption">
					<div class="permit-band" aria-hidden="true"></div>
					<div class="permit-body">
						<p class="permit-type mono">MANDATE · 合成示例</p>
						<dl>
							{permit.map(([key, value]) => (<div><dt>{key}</dt><dd class="mono">{value}</dd></div>))}
						</dl>
						<p class="permit-stamp mono" aria-label="状态：生效中">ACTIVE</p>
					</div>
					<figcaption id="permit-caption">每次执行都记录是谁、凭哪项授权、由谁批准。</figcaption>
				</figure>
			</section>

			<section id="evidence" class="section split split-reverse wrap" aria-labelledby="evidence-title">
				<figure class="receipt" aria-labelledby="receipt-caption">
					<div class="receipt-paper mono">
						<p class="receipt-head">EXPLAIN · QueryRun</p>
						<dl>
							<div><dt>integrity</dt><dd class="pass">verified</dd></div>
							<div><dt>status</dt><dd>completed</dd></div>
							<div><dt>approver</dt><dd>human · reviewer</dd></div>
							<div><dt>sql_hash</dt><dd>sha256:9cf3…49e810</dd></div>
						</dl>
						<p class="receipt-sub">evidence</p>
						<p class="receipt-list">candidate · policy · query · assurance · source · approval · result · mandate · authorization</p>
						<p class="receipt-sub">limitations</p>
						<ul class="receipt-limits">
							{limitations.map((item) => <li set:html={item.replaceAll('_', '_<wbr>')} />)}
						</ul>
					</div>
					<figcaption id="receipt-caption">字段取自合成 Quickstart 的 Explain 输出，hash 已截短。</figcaption>
				</figure>
				<div class="split-copy">
					<p class="eyebrow">证据</p>
					<h2 id="evidence-title">证据里也写着<br />没有证明的部分。</h2>
					<p>Explain 从同一个 QueryRun 回读实际执行的 SQL、结果、语义来源、审批人与授权链。证据在写入时绑定 hash，事后被改动就会失败关闭。</p>
					<p><code>verified</code> 只说明证据链完整。业务语义是否正确、实时数据有没有快照、结果是否被截断，Forge 会把这些限制一起交给你。</p>
				</div>
			</section>

			<section id="record" class="section wrap" aria-labelledby="record-title">
				<header class="section-head section-head-row">
					<div>
						<p class="eyebrow">验证记录 · 2026-10-22 · 提交 e50b0a0</p>
						<h2 id="record-title">公开测过什么，<br />也公开没测过什么。</h2>
					</div>
					<a class="text-link" href={report} rel="noopener">阅读公开测试摘要<span aria-hidden="true">↗</span></a>
				</header>
				<ul class="figures">
					{record.map((item) => (
						<li>
							<p class="figure"><span>{item.figure}</span><small class="mono">{item.unit}</small></p>
							<p class="figure-label">{item.label}</p>
							<p class="figure-note">{item.note}</p>
						</li>
					))}
				</ul>
				<div class="record-grid">
					<div class="accuracy">
						<p class="eyebrow">准确率</p>
						<p class="accuracy-line"><span class="mono">BIRD 500 题</span>Forge <strong>313</strong> · Direct SQL <strong>314</strong></p>
						<p>同一批候选经最终编译器重评，统计上持平（exact p = 1.0）。我们不宣称 Forge 提高了准确率；它解决的是生成之后的约束与证据。</p>
						<a class="text-link" href="/reference/benchmarks/">基准测试与边界<span aria-hidden="true">→</span></a>
					</div>
					<div class="gaps">
						<p class="eyebrow">尚未验证</p>
						<ul>{unverified.map((item) => <li>{item}</li>)}</ul>
					</div>
				</div>
			</section>

			<section id="start" class="start" aria-labelledby="start-title">
				<div class="wrap split">
					<div class="split-copy">
						<p class="eyebrow">本地试跑</p>
						<h2 id="start-title">五分钟，<br />看一遍完整的关口。</h2>
						<p>需要 Git、Bash 与 Python 3.11 或更新版本。Quickstart 在本地创建合成数据与合成身份，先演示写入被拒，再走一遍放行、审核、撤销与 Explain。</p>
						<a class="button button-signal" href="/guides/quickstart/">阅读上手指南<span aria-hidden="true">→</span></a>
					</div>
					<div class="terminal">
						<div class="terminal-head">
							<span class="mono">shell</span>
							<button class="copy" type="button" data-copy={install} aria-label="复制安装命令">复制</button>
						</div>
						<pre tabindex="0" aria-label="安装与运行命令"><code>{install.split('\n').map((line) => (<span class="line"><span class="prompt" aria-hidden="true">$</span>{line}</span>))}</code></pre>
					</div>
				</div>
			</section>

			<section class="section wrap faq" aria-labelledby="faq-title">
				<header class="section-head">
					<p class="eyebrow">常见问题</p>
					<h2 id="faq-title">接入之前，先把边界说清楚。</h2>
				</header>
				<div class="faq-list">
					{faqs.map(([q, a]) => (<details><summary>{q}</summary><p>{a}</p></details>))}
				</div>
			</section>
		</main>

		<footer class="footer">
			<div class="hazard" aria-hidden="true"></div>
			<div class="wrap footer-inner">
				<a class="brand" href="/" aria-label="Forge 首页"><Mark size={26} /><span>FORGE</span></a>
				<p class="footer-tag">开源的 Data Agent 可信数据运行时</p>
				<nav aria-label="页脚">
					<a href="/guides/introduction/">文档</a>
					<a href={report} rel="noopener">公开测试摘要</a>
					<a href={github} rel="noopener">GitHub</a>
					<a href={`${github}/issues`} rel="noopener">反馈</a>
					<a href={`${github}/blob/main/LICENSE`} rel="noopener">Apache-2.0</a>
				</nav>
			</div>
		</footer>

		<p class="toast" role="status" aria-live="polite" data-toast></p>

		<script>
			const toast = document.querySelector<HTMLElement>('[data-toast]');
			let toastTimer: number | undefined;
			const say = (message: string) => {
				if (!toast) return;
				toast.textContent = message;
				toast.classList.add('is-visible');
				window.clearTimeout(toastTimer);
				toastTimer = window.setTimeout(() => toast.classList.remove('is-visible'), 1800);
			};
			document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((button) => {
				button.addEventListener('click', async () => {
					try {
						await navigator.clipboard.writeText(button.dataset.copy ?? '');
						say('已复制到剪贴板');
					} catch {
						say('浏览器不允许自动复制，请手动选择文本');
					}
				});
			});

			const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
			const nav = document.getElementById('site-nav');
			const setMenu = (open: boolean) => {
				toggle?.setAttribute('aria-expanded', String(open));
				document.body.classList.toggle('menu-open', open);
			};
			toggle?.addEventListener('click', () => setMenu(toggle.getAttribute('aria-expanded') !== 'true'));
			nav?.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => setMenu(false)));
			document.addEventListener('keydown', (event) => { if (event.key === 'Escape') setMenu(false); });

			const board = document.querySelector<HTMLElement>('[data-board]');
			document.querySelector('[data-replay]')?.addEventListener('click', () => {
				if (!board) return;
				board.classList.remove('is-playing');
				void board.offsetWidth;
				board.classList.add('is-playing');
			});
			if (board) {
				const observer = new IntersectionObserver((entries) => {
					if (entries.some((entry) => entry.isIntersecting)) {
						board.classList.add('is-playing');
						observer.disconnect();
					}
				}, { threshold: 0.25 });
				observer.observe(board);
			}
		</script>
	</body>
</html>
