---
import Mark from '../components/Mark.astro';
import '../styles/landing.css';

const github = 'https://github.com/shisuidata/Forge';
const report = `${github}/blob/main/docs/archive/engineering/latest-test-report-2026-10-14.md`;
const steps = [
  { id: 'evaluate', number: '01', name: 'Evaluate', label: '先评测，再迭代', description: '比较模型、Prompt 与候选版本。保留失败分类和原始结果，让每次变化都有可复核的基线。', detail: '评测不授予执行权', link: '/reference/benchmarks/' },
  { id: 'enforce', number: '02', name: 'Enforce', label: '把边界放进执行路径', description: '将身份、任务、资源范围与策略绑定到 QueryRun。需要审核时，批准的是实际要执行的查询。', detail: '授权与审批绑定查询', link: '/concepts/how-it-works/' },
  { id: 'explain', number: '03', name: 'Explain', label: '交付结果，也交付依据', description: '把实际 SQL、语义来源、版本和审批链交给消费者。证据不足、实时数据与截断，都应明确可见。', detail: '证据不等于语义正确', link: '/guides/introduction/' },
];
const command = 'git clone https://github.com/shisuidata/Forge\ncd Forge\nbash scripts/bootstrap-dev.sh\nsource .venv/bin/activate\nforge quickstart';
const faqs = [
  ['Forge 是另一个聊天机器人吗？', '不是。Forge 位于既有 Agent 与数据库之间，提供生成后的评测、受控执行和证据。Web 工作台与 Pi 是消费者；外部 Agent 也可以独立接入 Forge。'],
  ['必须让模型生成 Forge JSON 吗？', '不必。Direct SQL 和 Forge JSON 是可替换的候选输入，共用 QueryRun 治理链路。Forge JSON 是可选的 Planner Adapter，不是产品边界；不同输入的语义校验强度也不完全相同。'],
  ['Quickstart 会访问我的数据库或调用模型吗？', '不会。公开 Quickstart 使用隔离的合成 SQLite 数据和真实本地 HTTP API，不需要 LLM、API Key、Pi 或已有数据库。默认会展示实际 SQL，等待你明确批准。'],
  ['现在能直接接入生产吗？', '不建议。当前仍是开发验证阶段，最新公开评估记录有两项未关闭的 P0 安全发布阻断；真实企业权限、共享多租户、独立安全审核与外部采用尚未验收。先阅读验证报告，再做隔离评估。'],
];
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f7f8f5" />
    <title>Forge — 为 Data Agent 建立可信数据边界</title>
    <meta name="description" content="面向企业 Data Agent 的开源可信数据运行时。通过 Evaluate、Enforce、Explain，让数据访问可验证、可约束、可追溯。" />
    <meta property="og:title" content="Forge — 为 Data Agent 建立可信数据边界" />
    <meta property="og:description" content="让 Agent 查询数据，不必交出控制权。探索开源 Trust Runtime 的评测、受控执行与证据链。" />
    <meta property="og:type" content="website" />
    <link rel="canonical" href="https://forge.ss-data.cc/" />
    <meta property="og:url" content="https://forge.ss-data.cc/" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  </head>
  <body>
    <a class="skip-link" href="#main">跳至内容</a>
    <header class="site-header">
      <div class="header-inner container">
        <a class="wordmark" href="/" aria-label="Forge 首页"><span class="brand-mark"><Mark /></span>forge<span class="wordmark-period">.</span></a>
        <button class="menu-toggle" aria-expanded="false" aria-controls="site-nav" aria-label="打开导航"><span></span><span></span></button>
        <nav id="site-nav" aria-label="主导航">
          <a href="#runtime">产品</a>
          <a href="#evidence">验证与边界</a>
          <a href="/guides/introduction/">文档 <span aria-hidden="true">↗</span></a>
          <a class="nav-github" href={github}>GitHub <span aria-hidden="true">↗</span></a>
          <a class="button button-small" href="/guides/quickstart/">开始构建 <span aria-hidden="true">→</span></a>
        </nav>
      </div>
    </header>
    <main id="main">
      <section class="hero container" aria-labelledby="hero-heading">
        <div class="hero-heading">
          <a class="release-note" href={report}><span class="status-dot"></span>开源 · 开发验证阶段 <span class="release-divider"></span> 查看最新验证记录 <span aria-hidden="true">↗</span></a>
          <p class="eyebrow">THE TRUST LAYER FOR DATA AGENTS</p>
          <h1 id="hero-heading">让 Agent 查询数据，<br />不必交出<span class="accent-word">控制权<svg viewBox="0 0 220 12" fill="none" aria-hidden="true"><path d="M2 8c57-7 139-8 214-4M16 11c55-4 112-6 174-4" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg></span>。</h1>
          <p class="hero-description">模型负责提出候选。<strong>Forge 让访问有边界、执行可审核、结果有依据。</strong><br class="desktop-break" />接入既有 Agent，而不是再迁移一套聊天工具。</p>
          <div class="hero-actions">
            <a class="button" href="/guides/quickstart/">运行第一个受控查询 <span aria-hidden="true">↗</span></a>
            <a class="text-link" href="#runtime">看看它如何工作 <span aria-hidden="true">↓</span></a>
          </div>
          <div class="hero-meta"><span>Apache 2.0</span><span>本地优先</span><span>无需模型即可试跑</span></div>
        </div>
        <div class="runtime-window" aria-label="Forge 执行链路示意">
          <div class="window-top"><span class="window-title"><Mark size={20} /> FORGE / QUERY INSPECTOR</span><span class="demo-label">示意 · 非实时服务</span></div>
          <div class="inspector-grid">
            <div class="inspector-sidebar">
              <span class="tiny-label">DATA REQUEST</span>
              <p class="request-question">按地区汇总销售额</p>
              <div class="context-line"><span class="context-icon" aria-hidden="true">↳</span><span>source <strong>demo.sales</strong></span></div>
              <div class="context-line"><span class="context-icon" aria-hidden="true">↳</span><span>scope <strong>read only</strong></span></div>
              <div class="context-line"><span class="context-icon" aria-hidden="true">↳</span><span>purpose <strong>sales analysis</strong></span></div>
              <div class="sidebar-divider"></div>
              <span class="tiny-label">TRUST PIPELINE</span>
              <div class="stage-tabs" role="tablist" aria-label="查看执行链路阶段" aria-orientation="vertical">
                {steps.map((step, index) => <button id={`tab-${step.id}`} role="tab" aria-selected={index === 0 ? 'true' : 'false'} aria-controls={`panel-${step.id}`} tabindex={index === 0 ? 0 : -1}><span class="stage-number">{step.number}</span><span>{step.name}</span><span class="stage-arrow" aria-hidden="true">↗</span></button>)}
              </div>
              <a class="inspector-docs" href="/concepts/how-it-works/">探索完整生命周期 <span aria-hidden="true">↗</span></a>
            </div>
            <div class="inspector-main">
              <section id="panel-evaluate" class="stage-panel" role="tabpanel" aria-labelledby="tab-evaluate" tabindex="0">
                <div class="panel-heading"><div><span class="tiny-label">01 / EVALUATE</span><h2>从可复核的候选开始。</h2></div><span class="sample-tag">合成样例</span></div>
                <div class="code-view"><div class="code-label">candidate.sql <span>SQL</span></div><pre><code><span class="code-line"><i>1</i><b>SELECT</b> region,</span><span class="code-line"><i>2</i>       <em>SUM</em>(revenue) <b>AS</b> revenue</span><span class="code-line"><i>3</i><b>FROM</b> demo.sales</span><span class="code-line"><i>4</i><b>GROUP BY</b> region;</span></code></pre></div>
                <div class="review-row"><span><span class="row-symbol" aria-hidden="true">◇</span>候选、版本与预期结果</span><span>可比较</span></div>
                <div class="review-row"><span><span class="row-symbol" aria-hidden="true">◇</span>Policy / Failure taxonomy</span><span>可诊断</span></div>
                <div class="panel-note"><span aria-hidden="true">↳</span>评测与执行分离。评测通过，不等于获得数据库执行权。</div>
              </section>
              <section id="panel-enforce" class="stage-panel" role="tabpanel" aria-labelledby="tab-enforce" tabindex="0" hidden>
                <div class="panel-heading"><div><span class="tiny-label">02 / ENFORCE</span><h2>允许执行，是另一个决定。</h2></div><span class="sample-tag">合成样例</span></div>
                <div class="authorization-card"><div class="authorization-icon" aria-hidden="true">⌘</div><div><span class="tiny-label">GOVERNED QUERYRUN</span><h3>身份、范围、策略，绑定在一起。</h3></div></div>
                <dl class="binding-list"><div><dt>Principal</dt><dd>demo-agent</dd></div><div><dt>Resource scope</dt><dd>demo.sales</dd></div><div><dt>SQL / Policy revisions</dt><dd>hash-bound</dd></div><div><dt>Review</dt><dd>按授权范围决策</dd></div></dl>
                <div class="panel-note"><span aria-hidden="true">↳</span>范围外拒绝；需要人审时，审批绑定实际查询。本示意不执行授权。</div>
              </section>
              <section id="panel-explain" class="stage-panel" role="tabpanel" aria-labelledby="tab-explain" tabindex="0" hidden>
                <div class="panel-heading"><div><span class="tiny-label">03 / EXPLAIN</span><h2>一个结果，一条证据链。</h2></div><span class="sample-tag">合成样例</span></div>
                <div class="sample-result"><div class="result-row result-header"><span>region</span><span>revenue</span></div><div class="result-row"><span>East</span><span>128,400</span></div><div class="result-row"><span>West</span><span>96,200</span></div></div>
                <div class="evidence-chips"><span>实际 SQL</span><span>Registry 版本</span><span>审批链</span><span>显式限制</span></div>
                <div class="panel-note"><span aria-hidden="true">↳</span>合成结果，仅展示结构。完整 Evidence 也不证明业务语义正确。</div>
              </section>
            </div>
          </div>
          <div class="window-bottom"><span><span class="status-dot"></span>候选 → 受控执行 → Evidence</span><span>确定性校验 ≠ 开放世界正确性</span></div>
        </div>
        <div class="integration-strip"><span class="tiny-label">WORKS WITH YOUR STACK</span><div><span>Direct SQL</span><span class="integration-plus">+</span><span>Forge JSON</span><span class="integration-arrow" aria-hidden="true">→</span><strong>One governed path.</strong><span class="integration-separator"></span><span>你的 Agent</span><span>你的数据库</span></div></div>
      </section>
      <section id="runtime" class="runtime-section" aria-labelledby="runtime-heading">
        <div class="container">
          <div class="section-heading"><div><p class="eyebrow">LESS GUESSWORK. MORE ACCOUNTABILITY.</p><h2 id="runtime-heading">从“生成了答案”，<br />到“知道答案如何产生”。</h2></div><p>不替模型承诺正确。<br />让每一次访问，都能被检查、约束和追溯。</p></div>
          <div class="feature-grid">{steps.map(step => <article class="feature"><div class="feature-index"><span>{step.number}</span><span aria-hidden="true">↗</span></div><p class="feature-name">{step.name}<span class="feature-dot">.</span></p><h3>{step.label}</h3><p class="feature-description">{step.description}</p><a href={step.link}>{step.detail}<span aria-hidden="true">→</span></a></article>)}</div>
          <div class="boundary-strip"><span class="boundary-icon" aria-hidden="true">⊞</span><p><strong>不是替换你的 Agent，而是给它一个可信数据边界。</strong><br />Pi 负责任务编排，Forge 保留对数据执行的独立校验与否决能力。</p><a class="text-link" href="/reference/architecture/">查看架构 <span aria-hidden="true">↗</span></a></div>
        </div>
      </section>
      <section id="evidence" class="evidence-section container" aria-labelledby="evidence-heading">
        <div class="evidence-intro"><p class="eyebrow">BUILT IN THE OPEN</p><h2 id="evidence-heading">信任，不靠<br />一个漂亮数字。</h2><p>我们公开通过的测试，也保留失败、未知与限制。<br />测试通过，不等于生产安全。</p><a class="text-link" href={report}>阅读最新验证报告 <span aria-hidden="true">↗</span></a></div>
        <div class="evidence-ledger"><div class="ledger-heading"><span class="tiny-label">VERIFICATION RECORD</span><span>本地评估 · 2026.10.04</span></div><div class="ledger-row"><span>Python 回归</span><strong>1,011 <small>passed</small></strong><span class="ledger-note">另有 26 项 skipped</span></div><div class="ledger-row"><span>Pi Orchestrator</span><strong>212 <small>passed</small></strong><span class="ledger-note">TypeScript 检查通过</span></div><div class="ledger-row"><span>公开 Golden Path</span><strong class="ledger-text">实际链路跑通 <span aria-hidden="true">↗</span></strong><span class="ledger-note">隔离合成数据</span></div><p class="ledger-footnote">以上来自含未提交修改的本地工作树，不是当前公开提交、远端 CI 或部署认证。本轮官网改版未重跑上述测试。</p><div class="open-boundary"><span class="boundary-status">尚未关闭</span><p>两项 P0 安全发布阻断、独立安全审核与外部采用门禁。当前不建议用于真实生产或共享多租户数据访问。</p></div><a class="ledger-link" href="/reference/benchmarks/">查看基准、历史结果与可比性边界 <span aria-hidden="true">→</span></a></div>
      </section>
      <section id="quickstart" class="quickstart-section" aria-labelledby="quickstart-heading">
        <div class="container quickstart-grid"><div><p class="eyebrow">LOCAL FIRST. OPEN SOURCE.</p><h2 id="quickstart-heading">先跑通一次。<br /><span>再决定是否接入。</span></h2><p>不填模型 Key，不连客户数据库。<br />用隔离的合成数据，亲手走过一次评测、批准与解释。</p><a class="button" href="/guides/quickstart/">打开快速开始 <span aria-hidden="true">↗</span></a><span class="quickstart-caption">需要 Git、Python 与本地开发环境</span></div><div class="terminal"><div class="terminal-header"><span><i></i><i></i><i></i></span><span>YOUR TERMINAL</span><button id="copy-command" class="copy-button" aria-label="复制快速开始命令">复制 <span aria-hidden="true">⧉</span></button></div><pre id="quickstart-command"><code>{command}</code></pre><div class="terminal-footer"><span aria-hidden="true">↳</span>展示 SQL → 等待你批准 → 执行 → Explain</div><p id="copy-feedback" class="copy-feedback" role="status" aria-live="polite"></p></div></div>
      </section>
      <section class="faq-section container" aria-labelledby="faq-heading"><div><p class="eyebrow">A FEW GOOD QUESTIONS</p><h2 id="faq-heading">开始之前，<br />把边界说清楚。</h2></div><div class="faq-list">{faqs.map(([question, answer]) => <details><summary>{question}<span aria-hidden="true">+</span></summary><p>{answer}</p></details>)}</div></section>
      <section class="closing-section container"><div><span class="closing-symbol" aria-hidden="true"><Mark size={58} /></span><h2>把数据能力交给 Agent。<br /><span>把决定权留在边界之内。</span></h2></div><a class="button" href={github}>在 GitHub 探索 Forge <span aria-hidden="true">↗</span></a></section>
    </main>
    <footer class="site-footer"><div class="container footer-inner"><a class="wordmark" href="/" aria-label="Forge 首页"><span class="brand-mark"><Mark size={24} /></span>forge<span class="wordmark-period">.</span></a><p>Open source. Explicit boundaries.<br /><span>由拾穗数据维护 · Apache 2.0</span></p><nav aria-label="页脚导航"><a href="/guides/introduction/">文档</a><a href={report}>验证报告</a><a href={`${github}/issues`}>反馈问题 ↗</a><a href={`${github}/blob/main/LICENSE`}>许可证 ↗</a></nav><a class="back-top" href="#main" aria-label="返回顶部">↑</a></div></footer>
    <script>
      const menuButton = document.querySelector<HTMLButtonElement>('.menu-toggle');
      const navigation = document.querySelector<HTMLElement>('#site-nav');
      const closeMenu = () => {
        menuButton?.setAttribute('aria-expanded', 'false');
        menuButton?.setAttribute('aria-label', '打开导航');
        navigation?.classList.remove('is-open');
      };
      menuButton?.addEventListener('click', () => {
        const expanded = menuButton.getAttribute('aria-expanded') !== 'true';
        menuButton.setAttribute('aria-expanded', String(expanded));
        menuButton.setAttribute('aria-label', expanded ? '关闭导航' : '打开导航');
        navigation?.classList.toggle('is-open', expanded);
      });
      navigation?.querySelectorAll('a').forEach(link => link.addEventListener('click', closeMenu));
      document.addEventListener('keydown', event => {
        if (event.key === 'Escape' && menuButton?.getAttribute('aria-expanded') === 'true') {
          closeMenu();
          menuButton.focus();
        }
      });
      const tabs = [...document.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
      const tabList = document.querySelector('[role="tablist"]');
      const compactLayout = window.matchMedia('(max-width: 760px)');
      const syncLayout = () => {
        tabList?.setAttribute('aria-orientation', compactLayout.matches ? 'horizontal' : 'vertical');
        if (!compactLayout.matches) closeMenu();
      };
      compactLayout.addEventListener('change', syncLayout);
      syncLayout();
      function selectTab(tab: HTMLButtonElement) {
        for (const item of tabs) {
          const selected = item === tab;
          item.setAttribute('aria-selected', String(selected));
          item.tabIndex = selected ? 0 : -1;
          const panel = document.getElementById(item.getAttribute('aria-controls') ?? '');
          if (panel) panel.hidden = !selected;
        }
      }
      tabs.forEach((tab, index) => {
        tab.addEventListener('click', () => selectTab(tab));
        tab.addEventListener('keydown', event => {
          const direction = ['ArrowDown', 'ArrowRight'].includes(event.key) ? 1 : ['ArrowUp', 'ArrowLeft'].includes(event.key) ? -1 : 0;
          if (!direction && !['Home', 'End'].includes(event.key)) return;
          event.preventDefault();
          const target = tabs[event.key === 'Home' ? 0 : event.key === 'End' ? tabs.length - 1 : (index + direction + tabs.length) % tabs.length];
          selectTab(target);
          target.focus();
        });
      });
      const copyButton = document.querySelector<HTMLButtonElement>('#copy-command');
      const copyFeedback = document.getElementById('copy-feedback');
      copyButton?.addEventListener('click', async () => {
        const command = document.querySelector('#quickstart-command code')?.textContent;
        if (!command || !copyFeedback) return;
        try {
          await navigator.clipboard.writeText(command);
          copyFeedback.textContent = '已复制命令。请在自己的终端中运行。';
        } catch {
          copyFeedback.textContent = '浏览器未允许复制，请选中上方命令手动复制。';
        }
      });
    </script>
  </body>
</html>
